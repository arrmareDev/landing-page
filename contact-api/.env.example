PORT=3001
# Orígenes permitidos (separados por coma). Si la web y la API están bajo el mismo dominio vía Nginx, puedes dejarlo como está.
CORS_ORIGINS=http://localhost:5173,https://arrmaregroup.com,https://www.arrmaregroup.com

# SMTP (el del correo del dominio en cPanel, o el que uses). Si SMTP_HOST está vacío, NO se envía: solo se imprime en consola (modo prueba).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@arrmaregroup.com
SMTP_PASS=

# ALTERNATIVA al SMTP: relé PHP en el hosting (ver relay-php/). Si RELAY_URL está definido, se usa en lugar del SMTP.
# Útil cuando el VPS (p. ej. DigitalOcean) bloquea los puertos 465/587.
RELAY_URL=
RELAY_TOKEN=

# Quién recibe las consultas y desde qué dirección salen
MAIL_TO=contacto@arrmaregroup.com
MAIL_FROM="Web ARRMARE GROUP <contacto@arrmaregroup.com>"
